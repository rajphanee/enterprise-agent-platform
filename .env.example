# Copy this file to .env and edit.  (.env is git-ignored - never commit keys.)
#   cp .env.example .env

# offline = no network, keyword rules (default)   |   claude = real model
AGENT_MODE=offline

# Only needed when AGENT_MODE=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Where runtime files are written (audit log, approvals, vendor registry)
# AGENT_STATE_DIR=./var

# Knowledge assistant declines when the best match scores below this (0..1)
MIN_RETRIEVAL_SCORE=0.10

# IT tickets classified below this confidence go to a human (0..1)
MIN_CLASSIFIER_CONFIDENCE=0.60
